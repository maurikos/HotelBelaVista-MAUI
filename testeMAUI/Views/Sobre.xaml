<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="testeMAUI.Views.Sobre"
    Title="Sobre"
    BackgroundColor="#F4F7FA">

    <VerticalStackLayout
        Padding="30"
        Spacing="20"
        VerticalOptions="Center"
        MaximumWidthRequest="550">

        <Label
            Text="HOTEL BELA VISTA"
            FontSize="30"
            FontAttributes="Bold"
            TextColor="#167D8D"
            HorizontalOptions="Center" />

        <Border
            BackgroundColor="White"
            Stroke="#DDE5ED"
            Padding="25"
            StrokeShape="RoundRectangle 16">

            <VerticalStackLayout Spacing="15">

                <Label
                    Text="Sobre o aplicativo"
                    FontSize="24"
                    FontAttributes="Bold"
                    TextColor="#18324B" />

                <Label
                    Text="Aplicativo desenvolvido para simular a contratação de hospedagens, permitindo selecionar hóspedes, acomodações e datas para calcular o valor total da estadia."
                    FontSize="15"
                    TextColor="#475569" />

                <BoxView
                    HeightRequest="1"
                    Color="#DDE5ED" />

                <Label
                    Text="Desenvolvedor: Mauricio Pereira"
                    FontSize="16"
                    TextColor="#18324B" />

                <Label
                    Text="Ano de desenvolvimento: 2026"
                    FontSize="16"
                    TextColor="#18324B" />

                <Label
                    Text="Curso: Técnico em Desenvolvimento de Sistemas"
                    FontSize="16"
                    TextColor="#18324B" />

                <Label
                    Text="Instituição: Etec"
                    FontSize="16"
                    TextColor="#18324B" />

            </VerticalStackLayout>
        </Border>

    </VerticalStackLayout>
</ContentPage>
